<?xml version="1.0" ?>
<sdf version="1.8">
    <!-- Body Model -->
    <!--Weight Properties are inaccurate!-->
    <model name='atom_body' canonical_link='Body'>

        <!-- LINKS -->

        <link name='Body'>
            <pose relative_to='__model__'>0 0 0 0 0 0</pose>
            <inertial>
                <mass>1.14395</mass>
                <inertia>
                    <ixx>0.095329</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>0.381317</iyy>
                    <iyz>0</iyz>
                    <izz>0.476646</izz>
                </inertia>
            </inertial>
            <visual name='visual'>
                <geometry>
                <mesh>

                    <uri>models/atom/Body/Body.obj</uri>

                </mesh>
                </geometry>
            </visual>

            <collision name='collision'>
                <pose>-0.2 0 -0.0815 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.4 0.440 0.163</size>
                    </box>
                </geometry>
            </collision>
        </link>

        <link name='RL'>
            <pose relative_to='Body'>0.025 -0.305 0.013 0 0 0</pose>
            <inertial>
                <mass>1.14395</mass>
                <inertia>
                <ixx>0.095329</ixx>
                <ixy>0</ixy>
