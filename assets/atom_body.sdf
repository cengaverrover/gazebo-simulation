                <geometry>
                    <box>
                        <size>0.487 0.04 0.057</size>
                    </box>
                </geometry>
            </collision>
        </link>
        
        <link name='LL'>
            <pose relative_to='Body'>0.025 0.305 0.013 0 0 0</pose>
            <inertial>
                <mass>1.14395</mass>
                <inertia>
                <ixx>0.095329</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>0.381317</iyy>
                <iyz>0</iyz>
                <izz>0.476646</izz>
                </inertia>
            </inertial>
            <visual name='visual'>
                <geometry>
                <mesh>

                    <uri>models/atom/Body/LL.obj</uri>

                </mesh>
                </geometry>
            </visual>

            <collision name='A1'>
                <pose>-0.05192 -0.0325 0 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.487 0.04 0.057</size>
                    </box>
                </geometry>
            </collision>
        </link>

        <link name='RFW'>
            <pose relative_to='RL'>0.41717 -0.035 -0.22366 0 0 0</pose>
            <inertial>
                <mass>1.14395</mass>
                <inertia>
                <ixx>0.095329</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>0.381317</iyy>
                <iyz>0</iyz>
                <izz>0.476646</izz>
                </inertia>
            </inertial>
            <visual name='visual'>
                <geometry>
                <mesh>

                    <uri>models/atom/Body/Wheel_L.obj</uri>
                    <scale>1 -1 1</scale>

                </mesh>
                </geometry>
            </visual>

            <collision name="Middle">
            <pose>0 -0.098 0 1.5707 0 0</pose>
            <geometry>
                <cylinder>
                <radius>0.16</radius>
                <length>0.12</length>
                </cylinder>
            </geometry>
            </collision>
        </link>

        <link name='RBW'>
            <pose relative_to='RL'>-0.31739 -0.035 -0.22353 0 0 0</pose>
            <inertial>
                <mass>1.14395</mass>
                <inertia>
                <ixx>0.095329</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>0.381317</iyy>
                <iyz>0</iyz>
                <izz>0.476646</izz>
                </inertia>
            </inertial>
            <visual name='visual'>
                <geometry>
                <mesh>

                    <uri>models/atom/Body/Wheel_L.obj</uri>
                    <scale>1 -1 1</scale>

                </mesh>
                </geometry>
            </visual>

            <collision name="Middle">
            <pose>0 -0.098 0 1.5707 0 0</pose>
            <geometry>
                <cylinder>
                <radius>0.16</radius>
                <length>0.12</length>
                </cylinder>
            </geometry>
            </collision>
        </link>

        <link name='LBW'>
            <pose relative_to='LL'>-0.31739 0.035 -0.22353 0 0 0</pose>
            <inertial>
                <mass>1.14395</mass>
                <inertia>
                <ixx>0.095329</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>0.381317</iyy>
                <iyz>0</iyz>
                <izz>0.476646</izz>
                </inertia>
            </inertial>
            <visual name='visual'>
                <geometry>
                <mesh>

                    <uri>models/atom/Body/Wheel_L.obj</uri>
                    <scale>1 1 1</scale>

                </mesh>
                </geometry>
            </visual>

            <collision name="Middle">
            <pose>0 -0.098 0 1.5707 0 0</pose>
            <geometry>
                <cylinder>
                <radius>0.16</radius>
                <length>0.12</length>
                </cylinder>
            </geometry>
            </collision>
        </link>

        <link name='LFW'>
            <pose relative_to='LL'>0.41739 0.035 -0.22353 0 0 0</pose>
            <inertial>
                <mass>1.14395</mass>
                <inertia>
                <ixx>0.095329</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>0.381317</iyy>
                <iyz>0</iyz>
                <izz>0.476646</izz>
                </inertia>
            </inertial>
            <visual name='visual'>
                <geometry>
                <mesh>

                    <uri>models/atom/Body/Wheel_L.obj</uri>
                    <scale>1 1 1</scale>

                </mesh>
                </geometry>
            </visual>

            <collision name="Middle">
            <pose>0 -0.098 0 1.5707 0 0</pose>
            <geometry>
                <cylinder>
                <radius>0.16</radius>
                <length>0.12</length>
                </cylinder>
            </geometry>
            </collision>
        </link>

        <!-- JOINTS -->

        <joint name="Body_LL" type="revolute">
            <parent>Body</parent>
            <child>LL</child>
            <axis>
                <xyz>0 1 0</xyz>
                <limit>
                    <lower>0</lower>
                    <upper>0</upper>
                </limit>
            </axis>
        </joint>

        <joint name="Body_RL" type="revolute">
            <parent>Body</parent>
            <child>RL</child>
            <axis>
                <xyz>0 1 0</xyz>
            </axis>
        </joint>

        <joint name="LL_FW" type="revolute">
            <parent>LL</parent>
            <child>LFW</child>
            <axis>
                <xyz>0 1 0</xyz>
            </axis>
        </joint>
        <joint name="LL_BW" type="revolute">
            <parent>LL</parent>
            <child>LBW</child>
            <axis>
                <xyz>0 1 0</xyz>
            </axis>
        </joint>
        <joint name="RL_FW" type="revolute">
            <parent>RL</parent>
            <child>RFW</child>
            <axis>
                <xyz>0 1 0</xyz>
            </axis>
        </joint>
        <joint name="RL_BW" type="revolute">
            <parent>RL</parent>
            <child>RBW</child>
            <axis>
                <xyz>0 1 0</xyz>
            </axis>
        </joint>

        <!-- SENSORS -->

        <!-- LIDAR -->
        <link name="Lidar_Link">
            <pose relative_to="Body">-0.015 0 -0.115 0 0 0</pose>

            <sensor name='gpu_lidar' type='gpu_lidar'>
                <pose relative_to='Lidar_Link'>0 0 0 0 0 0</pose>
                <topic>lidar</topic>
                <update_rate>10</update_rate>
                <ray>
                    <scan>
                        <horizontal>
                            <samples>640</samples>
                            <resolution>1</resolution>
                            <min_angle>-3.141592653589793</min_angle>
                            <max_angle>3.141592653589793</max_angle>
                        </horizontal>
                        <vertical>
                            <samples>1</samples>
                            <resolution>0.01</resolution>
                            <min_angle>0</min_angle>
                            <max_angle>0</max_angle>
                        </vertical>
                    </scan>
                    <range>
                        <min>0.08</min>
                        <max>10.0</max>
                        <resolution>0.01</resolution>
                    </range>
                </ray>
                <always_on>1</always_on>
                <visualize>true</visualize>
            </sensor>
        </link>
        <joint name="LIDAR_Body" type="fixed">
            <parent>Body</parent>
            <child>Lidar_Link</child>
        </joint>

        <!-- Depth Camera -->
        <link name="depth_camera">
            <pose relative_to="Body">0.2325 0 0.015 0 0 0</pose>

            <sensor name="camera_sensor" type="camera">
                <always_on>true</always_on>
                <update_rate>30</update_rate>
                <visualize>true</visualize>

                <camera>
                <horizontal_fov>1.047</horizontal_fov> <!--60deg-->

                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>

                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>

                <clip>
                    <near>0.1</near>
                    <far>100</far>
                </clip>
                </camera>

                <topic>/rover/depth_camera/rgb</topic>
            </sensor>

            <sensor name="depth_sensor" type="depth_camera">
                <always_on>true</always_on>
                <update_rate>30</update_rate>
                <visualize>true</visualize>

                <camera>
                    <horizontal_fov>1.047</horizontal_fov>

                    <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R_FLOAT32</format>
                    </image>

                    <clip>
                    <near>0.1</near>
                    <far>10.0</far>
                    </clip>
                </camera>

                <topic>/rover/depth_camera/depth</topic>
            </sensor>
        </link>
        <joint name="Body_depth" type="fixed">
            <parent>Body</parent>
            <child>depth_camera</child>
        </joint>

        <!-- JOINT CONTROLLERS -->
        <!--Remember to replace values according to true robot-->
        <plugin filename="ignition-gazebo-joint-controller-system"
            name="ignition::gazebo::systems::JointController">
            <joint_name>RL_FW</joint_name>
            <p_gain>20.0</p_gain>     <!-- N·m per rad (approx) -->
            <d_gain>2.0</d_gain>      <!-- N·m·s per rad -->
            <i_gain>0.1</i_gain>      <!-- small integrator -->
            <i_min>-1.0</i_min>       <!-- clamp integral contribution (N·m) -->
            <i_max>1.0</i_max>
            <cmd_min>-1</cmd_min>
            <cmd_max>1</cmd_max>
        </plugin>
        <plugin filename="ignition-gazebo-joint-controller-system"
            name="ignition::gazebo::systems::JointController">
            <joint_name>RL_BW</joint_name>
            <p_gain>20.0</p_gain> 
            <d_gain>2.0</d_gain>
            <i_gain>0.1</i_gain>
            <i_min>-1.0</i_min>
            <i_max>1.0</i_max>
            <cmd_min>-1</cmd_min>
            <cmd_max>1</cmd_max>
        </plugin>
        <plugin filename="ignition-gazebo-joint-controller-system"
            name="ignition::gazebo::systems::JointController">
            <joint_name>LL_FW</joint_name>
            <p_gain>20.0</p_gain>
            <d_gain>2.0</d_gain>
            <i_gain>0.1</i_gain>
            <i_min>-1.0</i_min>
            <i_max>1.0</i_max>
            <cmd_min>-1</cmd_min>
            <cmd_max>1</cmd_max>
            </plugin>
        <plugin filename="ignition-gazebo-joint-controller-system"
            name="ignition::gazebo::systems::JointController">
            <joint_name>LL_BW</joint_name>
            <p_gain>20.0</p_gain>
            <d_gain>2.0</d_gain>
            <i_gain>0.1</i_gain>
            <i_min>-1.0</i_min>
            <i_max>1.0</i_max>
            <cmd_min>-1</cmd_min>
            <cmd_max>1</cmd_max>
        </plugin>

        <!-- Below plugins keep the relation between rocker(differential) and legs intact -->

        <plugin filename="ignition-gazebo-joint-controller-system"
            name="ignition::gazebo::systems::JointController">
            <joint_name>Body_LL</joint_name>
            <p_gain>20.0</p_gain>     <!-- N·m per rad (approx) -->
            <d_gain>2.0</d_gain>      <!-- N·m·s per rad -->
            <i_gain>0.1</i_gain>      <!-- small integrator -->
            <i_min>-1.0</i_min>       <!-- clamp integral contribution (N·m) -->
            <i_max>1.0</i_max>
            <cmd_min>-1</cmd_min>
            <cmd_max>1</cmd_max>
        </plugin>

        <plugin filename="ignition-gazebo-joint-controller-system"
            name="ignition::gazebo::systems::JointController">
            <joint_name>Body_RL</joint_name>
            <p_gain>20.0</p_gain>     <!-- N·m per rad (approx) -->
            <d_gain>2.0</d_gain>      <!-- N·m·s per rad -->
            <i_gain>0.1</i_gain>      <!-- small integrator -->
            <i_min>-1.0</i_min>       <!-- clamp integral contribution (N·m) -->
            <i_max>1.0</i_max>
            <cmd_min>-1</cmd_min>
            <cmd_max>1</cmd_max>
        </plugin>
    </model>
</sdf>