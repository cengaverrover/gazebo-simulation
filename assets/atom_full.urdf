<?xml version="1.0"?>
<robot name="atom">
  <!-- This file is used only for state publishing (robot/joint), and is not part of the simulation itself -->
  <!-- Base body link -->
  <link name="Body">
    <inertial>
      <mass value="1.14395"/>
      <inertia ixx="0.095329" ixy="0" ixz="0" iyy="0.381317" iyz="0" izz="0.476646"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="models/atom/Body/Body.obj"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.2 0 -0.0815"/>
      <geometry>
        <box size="0.4 0.44 0.163"/>
      </geometry>
    </collision>
  </link>

  <link name="atom"/>

  <joint name="atom_to_Body" type="fixed">
    <parent link="atom"/>
    <child link="Body"/>
    <origin xyz="0 0 0.355"/>
  </joint>

