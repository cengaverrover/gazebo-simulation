<link name="Lidar_Link"/>
<joint name="lidar_joint" type="fixed">
  <parent link="Body"/>
  <child link="Lidar_Link"/>
</joint>

  <!-- Depth camera -->
  <link name="depth_camera"/>

  <joint name="Body_depth" type="fixed">
    <parent link="Body"/>
    <child link="depth_camera"/>
    <origin xyz="0.2325 0 0.015"/>
  </joint>

