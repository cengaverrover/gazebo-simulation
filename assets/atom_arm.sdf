        <!-- SENSORS -->

        <!-- CAMERA -->
        <link name="arm_camera">
            <pose relative_to="STEM">0.01316 0.0139 0.71186 0 0 -1.5708</pose>
            
            <sensor name="camera_sensor" type="camera">
                <always_on>true</always_on>
                <update_rate>30</update_rate>
                <visualize>true</visualize>

                <camera>
                <horizontal_fov>1.047</horizontal_fov> <!--60deg-->

                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>

                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>

                <clip>
                    <near>0.1</near>
                    <far>100</far>
                </clip>
                </camera>

                <topic>/rover/arm_camera/rgb</topic>
            </sensor>
        </link>
        <joint name="A4_arm_cam" type="fixed">
            <parent>A4</parent>
            <child>arm_camera</child>
        </joint>
        
        <!-- JOINT CONTROLLERS -->

        <plugin filename="ignition-gazebo-joint-controller-system"
            name="ignition::gazebo::systems::JointController">
            <joint_name>STEM_A1</joint_name>
            <p_gain>20.0</p_gain>     <!-- N·m per rad (approx) -->
            <d_gain>2.0</d_gain>      <!-- N·m·s per rad -->
            <i_gain>0.1</i_gain>      <!-- small integrator -->
            <i_min>-1.0</i_min>       <!-- clamp integral contribution (N·m) -->
            <i_max>1.0</i_max>
            <cmd_min>-1</cmd_min>
            <cmd_max>1</cmd_max>
        </plugin>
