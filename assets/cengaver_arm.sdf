        <!-- JOINTS -->

        <joint name="STEM_TRUNK" type="revolute">
            <parent>STEM</parent>
            <child>TRUNK</child>

            <pose>0 0 0 0 0 0</pose>
            <axis>
                <xyz>0 0 1</xyz>
                <limit>
                    <lower>-1.57</lower>
                    <upper>1.57</upper>
                    <velocity>1.0</velocity>
                    <effort>1000.0</effort>
                </limit>
            </axis>
        </joint>

        <joint name="TRUNK_A1" type="revolute">
            <parent>TRUNK</parent>
            <child>A1</child>

            <axis>
