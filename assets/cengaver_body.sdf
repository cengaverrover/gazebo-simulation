        <!-- JOINTS -->

        <joint name="body_RL" type="revolute">
            <parent>body</parent>
            <child>RL</child>

            <pose>0 0 0 0 0 0</pose>
            <axis>
                <xyz>0 1 0</xyz>
            </axis>
        </joint>

        <joint name="body_LL" type="revolute">
            <parent>body</parent>
            <child>LL</child>

            <pose>0 0 0 0 0 0</pose>
            <axis>
                <xyz>0 1 0</xyz>
            </axis>
        </joint>

        <joint name="body_rocker" type="revolute">
            <parent>body</parent>
            <child>rocker</child>

            <pose>0 0 0 0 0 0</pose>
            <axis>
                <xyz>1 0 0</xyz>
            </axis>
        </joint>

        <joint name="RL_fr" type="revolute">
            <parent>RL</parent>
            <child>wheel-fr</child>

            <pose>0 0 0 0 0 0</pose>
            <axis>
                <xyz>0 1 0</xyz>
            </axis>
        </joint>

        <joint name="RL_br" type="revolute">
            <parent>RL</parent>
            <child>wheel-br</child>

            <pose>0 0 0 0 0 0</pose>
            <axis>
                <xyz>0 1 0</xyz>
            </axis>
        </joint>

        <joint name="LL_fl" type="revolute">
            <parent>LL</parent>
            <child>wheel-fl</child>

            <pose>0 0 0 0 0 0</pose>
            <axis>
                <xyz>0 1 0</xyz>
            </axis>
        </joint>

        <joint name="LL_bl" type="revolute">
            <parent>LL</parent>
            <child>wheel-bl</child>

            <pose>0 0 0 0 0 0</pose>
            <axis>
                <xyz>0 1 0</xyz>
            </axis>
        </joint>

        <!--JOINT CONTROLLERS-->
        <!--Remember to replace values according to true robot-->
        <plugin filename="ignition-gazebo-joint-controller-system"
            name="ignition::gazebo::systems::JointController">
            <joint_name>RL_fr</joint_name>
            <p_gain>20.0</p_gain>     <!-- N·m per rad (approx) -->
            <d_gain>2.0</d_gain>      <!-- N·m·s per rad -->
            <i_gain>0.1</i_gain>      <!-- small integrator -->
            <i_min>-1.0</i_min>       <!-- clamp integral contribution (N·m) -->
            <i_max>1.0</i_max>
            <cmd_min>-1</cmd_min>
            <cmd_max>1</cmd_max>
        </plugin>
        <plugin filename="ignition-gazebo-joint-controller-system"
            name="ignition::gazebo::systems::JointController">
            <joint_name>RL_br</joint_name>
            <p_gain>20.0</p_gain> 
            <d_gain>2.0</d_gain>
            <i_gain>0.1</i_gain>
            <i_min>-1.0</i_min>
            <i_max>1.0</i_max>
            <cmd_min>-1</cmd_min>
            <cmd_max>1</cmd_max>
        </plugin>
        <plugin filename="ignition-gazebo-joint-controller-system"
            name="ignition::gazebo::systems::JointController">
            <joint_name>LL_fl</joint_name>
            <p_gain>20.0</p_gain>
            <d_gain>2.0</d_gain>
            <i_gain>0.1</i_gain>
            <i_min>-1.0</i_min>
            <i_max>1.0</i_max>
            <cmd_min>-1</cmd_min>
            <cmd_max>1</cmd_max>
            </plugin>
        <plugin filename="ignition-gazebo-joint-controller-system"
            name="ignition::gazebo::systems::JointController">
            <joint_name>LL_bl</joint_name>
            <p_gain>20.0</p_gain>
            <d_gain>2.0</d_gain>
            <i_gain>0.1</i_gain>
            <i_min>-1.0</i_min>
            <i_max>1.0</i_max>
            <cmd_min>-1</cmd_min>
            <cmd_max>1</cmd_max>
        </plugin>

        <!-- The three below plugins keep the relation between rocker(differential) and legs intact (solution to parallel mechanism)-->

        <plugin filename="ignition-gazebo-joint-controller-system"
            name="ignition::gazebo::systems::JointController">
            <joint_name>body_LL</joint_name>
            <p_gain>20.0</p_gain>     <!-- N·m per rad (approx) -->
            <d_gain>2.0</d_gain>      <!-- N·m·s per rad -->
            <i_gain>0.1</i_gain>      <!-- small integrator -->
            <i_min>-1.0</i_min>       <!-- clamp integral contribution (N·m) -->
            <i_max>1.0</i_max>
            <cmd_min>-1</cmd_min>
            <cmd_max>1</cmd_max>
        </plugin>

        <plugin filename="ignition-gazebo-joint-controller-system"
            name="ignition::gazebo::systems::JointController">
            <joint_name>body_RL</joint_name>
            <p_gain>20.0</p_gain>     <!-- N·m per rad (approx) -->
            <d_gain>2.0</d_gain>      <!-- N·m·s per rad -->
            <i_gain>0.1</i_gain>      <!-- small integrator -->
            <i_min>-1.0</i_min>       <!-- clamp integral contribution (N·m) -->
            <i_max>1.0</i_max>
            <cmd_min>-1</cmd_min>
            <cmd_max>1</cmd_max>
        </plugin>

      <plugin
          filename="libbody_plugin.so"
          name="BodyPlugin">
      </plugin>
    </model>
